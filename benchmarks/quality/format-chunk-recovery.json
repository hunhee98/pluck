{
  "version": 1,
  "cases": [
    {
      "name": "java service",
      "path": "src/main/java/com/acme/AuthService.java",
      "min_chunks": 6,
      "source": [
        "package com.acme;",
        "",
        "import java.util.Optional;",
        "",
        "/**",
        " * Token lifecycle operations.",
        " */",
        "public final class AuthService {",
        "    private final TokenStore store;",
        "",
        "    public AuthService(TokenStore store) {",
        "        this.store = store;",
        "    }",
        "",
        "    public boolean verify(String token) {",
        "        return store.lookup(token).isPresent();",
        "    }",
        "}",
        "",
        "interface TokenStore {",
        "    Optional<String> lookup(String token);",
        "}",
        "",
        "record LoginRequest(String token) {}",
        "",
        "enum AuthStatus {",
        "    VALID,",
        "    EXPIRED",
        "}"
      ],
      "expected": [
        { "symbol": "AuthService", "kind": "Class", "doc_contains": "Token lifecycle operations" },
        { "symbol": "AuthService", "kind": "Method", "contains": "this.store = store" },
        { "symbol": "verify", "kind": "Method", "contains": "store.lookup" },
        { "symbol": "TokenStore" },
        { "symbol": "LoginRequest" },
        { "symbol": "AuthStatus", "kind": "Enum" }
      ]
    },
