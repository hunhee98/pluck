        { "symbol": "stage 2: debian:bookworm-slim", "kind": "Module" },
        { "symbol": "deps: Cargo.toml Cargo.lock ./", "kind": "Module" },
        { "symbol": "install: apt-get install", "kind": "Module", "contains": "libssl-dev" },
        { "symbol": "RUN cargo build --release", "kind": "Module" }
